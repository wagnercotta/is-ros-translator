# Copy to deploy/lab/.env; replace the placeholder secrets before starting.
# Use alphanumeric passwords: the broker password also appears in an AMQP URI.
LAB_RABBITMQ_USER=rostranslator
LAB_RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
LAB_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LAB_ROS_DOMAIN_ID=0
# IPv4 of the Raspberry Pi exposing the Create3 ROS 2 graph (not a hostname).
# Automatically injected into configs/fastdds-unicast.example.xml at image build.
# No separate local fastdds-unicast.xml file is required.
LAB_PI_WIFI_IP=REPLACE_WITH_RASPBERRY_PI_IPV4
# Optional, for --profile ros1: allow the Core to route to the ROS1 simulator.
# LAB_CORE_CONFIG=../../configs/create3-ros1-lab.yaml
