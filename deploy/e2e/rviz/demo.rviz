Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 36; 39; 45
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
      Alpha: 0.4
      Color: 140; 140; 140
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Occupancy Map
      Alpha: 0.45
      Color Scheme: map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Robot TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Keep: 25
      Shape: Arrow
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Robot Trajectory
      Color: 255; 170; 0
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /pris_demo/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot and Goal
      Topic:
        Value: /pris_demo/marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0.8
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1600
  X: 0
  Y: 0
